{
  "name": "mix-n-matchers",
  "version": "3.0.0",
  "description": "Miscellaneous custom Jest compatible matchers",
  "keywords": [
    "assertions",
    "extend",
    "extended",
    "jest",
    "matchers",
    "rstest",
    "test",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/EskiMojo14/mix-n-matchers#readme",
  "bugs": {
    "url": "https://github.com/EskiMojo14/mix-n-matchers/issues"
  },
  "license": "MIT",
  "author": "eskimojo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EskiMojo14/mix-n-matchers.git"
  },
  "files": [
    "dist",
    "types",
    "all",
    "jest-globals",
    "rstest",
    "vitest",
    "utilities"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./types/all.d.mts",
        "default": "./dist/all.mjs"
      },
      "require": {
        "types": "./types/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./jest-globals": {
      "import": {
        "types": "./types/jest-globals.d.mts",
        "default": "./dist/jest-globals.mjs"
      },
      "require": {
        "types": "./types/jest-globals.d.cts",
        "default": "./dist/jest-globals.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./types/vitest.d.mts",
        "default": "./dist/vitest.mjs"
      },
      "require": {
        "types": "./types/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./rstest": {
      "import": {
        "types": "./types/rstest.d.mts",
        "default": "./dist/rstest.mjs"
      },
      "require": {
        "types": "./types/rstest.d.cts",
        "default": "./dist/rstest.cjs"
      }
    },
    "./utilities": {
      "import": {
        "types": "./dist/utilities.d.mts",
        "default": "./dist/utilities.mjs"
      },
      "require": {
        "types": "./dist/utilities.d.cts",
        "default": "./dist/utilities.cjs"
      }
    }
  },
  "scripts": {
    "prepare": "vp config",
    "prebuild": "vpr typecheck",
    "build:only": "vp pack",
    "build": "vpr build:only",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:dist": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-dist.config.ts",
    "vitest": "FORCE_COLOR=1 vp test",
    "vitest:dist": "FORCE_COLOR=1 vp test --config vitest-dist.config.ts",
    "rstest": "FORCE_COLOR=1 rstest run",
    "rstest:dist": "FORCE_COLOR=1 rstest run --config rstest-dist.config.ts",
    "test:all": "vpr test && vpr vitest --run && vpr rstest",
    "test:all:dist": "vpr test:dist && vpr vitest:dist --run && vpr rstest:dist",
    "lint": "vp lint",
    "format": "vp fmt",
    "attw": "attw",
    "publint": "publint",
    "typecheck": "tsc",
    "prepack": "vpr publint --pack false",
    "website": "vpr --filter website start"
  },
  "dependencies": {
    "@jest/expect-utils": "^30.5.2",
    "jest-matcher-utils": "^30.5.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/expect": "^30.5.2",
    "@jest/globals": "^30.5.2",
    "@rstest/core": "^0.12.3",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@vitest/expect": "catalog:",
    "ansi-regex": "^6.4.0",
    "ansi-styles": "^7.0.0",
    "expect": "^30.5.2",
    "jest": "^30.5.2",
    "mutative": "^1.3.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.11.2",
    "jest": ">=28.0.0",
    "vitest": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@rstest/core": {
      "optional": true
    }
  },
  "engines": {
    "node": "^14.15.0 || ^16.10.0 || >=18.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
