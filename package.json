{
  "name": "mix-n-matchers",
  "version": "2.5.0",
  "description": "Miscellaneous custom Jest compatible matchers",
  "keywords": [
    "assertions",
    "extend",
    "extended",
    "jest",
    "matchers",
    "rstest",
    "test",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/EskiMojo14/mix-n-matchers#readme",
  "bugs": {
    "url": "https://github.com/EskiMojo14/mix-n-matchers/issues"
  },
  "license": "MIT",
  "author": "eskimojo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EskiMojo14/mix-n-matchers.git"
  },
  "files": [
    "dist",
    "types",
    "all",
    "jest-globals",
    "rstest",
    "vitest",
    "utilities"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./types/all.d.mts",
        "default": "./dist/all.mjs"
      },
      "require": {
        "types": "./types/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./jest-globals": {
      "import": {
        "types": "./types/jest-globals.d.mts",
        "default": "./dist/jest-globals.mjs"
      },
      "require": {
        "types": "./types/jest-globals.d.cts",
        "default": "./dist/jest-globals.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./types/vitest.d.mts",
        "default": "./dist/vitest.mjs"
      },
      "require": {
        "types": "./types/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./rstest": {
      "import": {
        "types": "./types/rstest.d.mts",
        "default": "./dist/rstest.mjs"
      },
      "require": {
        "types": "./types/rstest.d.cts",
        "default": "./dist/rstest.cjs"
      }
    },
    "./utilities": {
      "import": {
        "types": "./dist/utilities.d.mts",
        "default": "./dist/utilities.mjs"
      },
      "require": {
        "types": "./dist/utilities.d.cts",
        "default": "./dist/utilities.cjs"
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "prebuild": "pnpm run typecheck",
    "build:only": "tsdown",
    "build": "pnpm run build:only",
    "test": "pnpm node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:dist": "pnpm node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-dist.config.ts",
    "vitest": "FORCE_COLOR=1 vitest",
    "vitest:dist": "FORCE_COLOR=1 vitest --config vitest-dist.config.ts",
    "rstest": "rstest run",
    "rstest:dist": "rstest run --config rstest-dist.config.ts",
    "test:all": "pnpm run test && pnpm run vitest --run && pnpm run rstest",
    "test:all:dist": "pnpm run test:dist && pnpm run vitest:dist --run && pnpm run rstest:dist",
    "lint": "oxlint",
    "format": "oxfmt",
    "pre-commit": "lint-staged",
    "attw": "attw",
    "publint": "publint",
    "typecheck": "tsc",
    "prepack": "pnpm run publint --pack false",
    "website": "pnpm --filter website start"
  },
  "dependencies": {
    "@jest/expect-utils": "^30.4.1",
    "jest-matcher-utils": "^30.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/expect": "^30.4.1",
    "@jest/globals": "^30.4.1",
    "@rstest/core": "^0.11.9",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.2.0",
    "@vitest/expect": "^4.1.11",
    "ansi-regex": "^6.3.0",
    "ansi-styles": "^7.0.0",
    "expect": "^30.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "mutative": "^1.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.11.2",
    "jest": ">=28.0.0",
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@rstest/core": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "tsdown": {
    "deps": {
      "neverBundle": [
        "@jest/globals"
      ]
    },
    "dts": {
      "entry": [
        "src/index.ts",
        "src/utilities.ts"
      ]
    },
    "entry": [
      "src/index.ts",
      "src/all.ts",
      "src/jest-globals.ts",
      "src/vitest.ts",
      "src/rstest.ts",
      "src/utilities.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "sourcemap": true
  },
  "engines": {
    "node": "^14.15.0 || ^16.10.0 || >=18.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
