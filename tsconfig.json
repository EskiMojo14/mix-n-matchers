{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "esnext",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "lib": ["ESNext"],
    "allowImportingTsExtensions": true,
    "paths": {
      "mix-n-matchers": ["./src/index"],
      "@globals": ["./src/utils/globals"]
    },
    "types": ["node", "jest"]
  },
  "exclude": ["website"]
}
